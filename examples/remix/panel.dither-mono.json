{ "title": "Dither Mono", "slug": "dither-mono",
  "presets": {
    "as picked": {},
    "inverted": { "--rx-color-bg": "#0a0a0a", "--rx-color-text": "#f2f2ee", "--rx-color-6": "#161616", "--rx-color-5": "#f2f2ee", "--rx-color-4": "#f2f2ee", "--p-hero-invert": 1, "--p-cta-bg": "#f2f2ee", "--p-cta-fg": "#111", "--p-footer-bg": "#f2f2ee" },
    "soft grain": { "--p-hero-contrast": 1.3, "--p-grain-opacity": 0.25, "--p-border-w": "1px", "--p-radius": "6px", "--p-shadow": "0 18px 44px -24px rgba(0,0,0,.35)", "shaders.hero.roughness": 0.2 },
    "brutal": { "--p-border-w": "2px", "--p-h1-track": "-0.05em", "--p-h1-scale": 1.15, "--p-section-pad": 1.8, "--p-grid-size": "72px", "--p-grid-alpha": 0.12, "--p-hero-contrast": 2.4 },
    "one hot accent": { "--rx-color-4": "#ff3d00", "--rx-color-13": "#ffe3d6", "shaders.dither.colorFront": "#ff3d00", "--p-cta-bg": "#ff3d00", "--p-cta-fg": "#fff" }

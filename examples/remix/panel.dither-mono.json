    { "id": "motion.reveal.duration", "label": "Reveal duration", "group": "Motion", "type": "number", "default": 0.5, "min": 0, "max": 2, "step": 0.05 },
    { "id": "motion.reveal.ease",     "label": "Ease", "group": "Motion", "type": "select", "default": "cubic-bezier(0.2, 0, 0, 1)", "options": ["cubic-bezier(0.2, 0, 0, 1)", "cubic-bezier(0.16, 1, 0.3, 1)", "cubic-bezier(0.34, 1.56, 0.64, 1)", "cubic-bezier(0.7, 0, 0.2, 1)", "linear"], "labels": ["standard", "expo out", "spring", "snap", "linear"] },
    { "id": "motion.stagger",         "label": "Stagger", "group": "Motion", "type": "number", "default": 0.06, "min": 0, "max": 0.3, "step": 0.01 },

    { "id": "shaders.publish.speed",     "label": "Publish speed", "group": "GPU", "type": "number", "default": 0.6, "min": 0, "max": 4, "step": 0.1 },

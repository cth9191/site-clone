    { "id": "shaders.hero.drops",     "label": "Paper drops", "group": "Texture", "type": "number", "default": 0.5, "min": 0, "max": 1, "step": 0.02 },
    { "id": "shaders.hero.crumples",  "label": "Crumples", "group": "Texture", "type": "number", "default": 0.15, "min": 0, "max": 1, "step": 0.02 },
    { "id": "shaders.hero.fiber",     "label": "Fiber", "group": "Texture", "type": "number", "default": 0, "min": 0, "max": 1, "step": 0.02 },

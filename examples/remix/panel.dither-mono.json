    { "id": "--p-cta-bg",      "label": "Hero CTA bg", "group": "Color", "type": "color", "default": "#ffffff" },
    { "id": "--p-cta-fg",      "label": "Hero CTA text", "group": "Color", "type": "color", "default": "#111111" },


    { "id": "shaders.publish.intensity", "label": "Publish intensity", "group": "GPU", "type": "number", "default": 0.7, "min": 0, "max": 1, "step": 0.05 },
    { "id": "shaders.publish.softness",  "label": "Publish softness", "group": "GPU", "type": "number", "default": 0.5, "min": 0, "max": 1, "step": 0.05 },
    { "id": "shaders.meter.speed",       "label": "Meter speed", "group": "GPU", "type": "number", "default": 0.6, "min": 0, "max": 4, "step": 0.1 },
    { "id": "shaders.meter.intensity",   "label": "Meter intensity", "group": "GPU", "type": "number", "default": 0.6, "min": 0, "max": 1, "step": 0.05 },
    { "id": "shaders.compose.speed",     "label": "Compose speed", "group": "GPU", "type": "number", "default": 0.6, "min": 0, "max": 4, "step": 0.1 },
    { "id": "shaders.compose.noise",     "label": "Compose noise", "group": "GPU", "type": "number", "default": 1, "min": 0, "max": 1, "step": 0.05 },

    { "id": "--p-footer-bg",          "label": "Reveal bg", "group": "Footer", "type": "color", "default": "#000000" },
    { "id": "shaders.dither.colorFront","label": "Dither color", "group": "Footer", "type": "color", "default": "#ffffff" },
    { "id": "shaders.dither.size",    "label": "Dither size", "group": "Footer", "type": "number", "default": 7, "min": 2, "max": 24, "step": 1 },
    { "id": "shaders.dither.speed",   "label": "Dither speed", "group": "Footer", "type": "number", "default": 1, "min": 0, "max": 4, "step": 0.1 },
    { "id": "shaders.dither.shape",   "label": "Dither shape", "group": "Footer", "type": "select", "default": "dots", "options": ["dots", "simplex", "warp", "ripple", "swirl", "sphere"] },
    { "id": "--p-exhibit-contrast",   "label": "Exhibit contrast", "group": "Footer", "type": "number", "default": 1.8, "min": 0.8, "max": 3, "step": 0.05 },
    { "id": "--p-exhibit-gray",       "label": "Exhibit desaturate", "group": "Footer", "type": "number", "default": 1, "min": 0, "max": 1, "step": 0.05 }
